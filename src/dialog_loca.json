[
 {
  "contentuid": "h73a263d8gc8e4g5dfcgb090g4329ba189ad6",
  "version": 1,
  "text": "Return what you took from my Archive."
 },
 {
  "contentuid": "heb6f1c8bg4c66g5c5cgb890g0647d5b99ae1",
  "version": 1,
  "text": "Let me travel at your side until the Crown is within reach. Consider it an investment in our partnership."
 },
 {
  "contentuid": "hb7772297ga888g51efg81a2gfecba024f373",
  "version": 1,
  "text": "Very well. Join us."
 },
 {
  "contentuid": "hb6104969gb63fg5c25g8ed2g4481421b67b0",
  "version": 1,
  "text": "No. We'll manage without you."
 },
 {
  "contentuid": "hbe15cfe5gba86g5a8fgb29bg1ea1badf2d27",
  "version": 1,
  "text": "<i>Leave.</i>"
 },
 {
  "contentuid": "hc78e0077g7fdeg5228g919bg44e53a9bb0ba",
  "version": 1,
  "text": "[Return the stolen items] Fine. Take them back."
 },
 {
  "contentuid": "hb5f73b8eg443cg51d5g9177g364e3ccebf10",
  "version": 1,
  "text": "No. You'll get nothing back from me."
 },
 {
  "contentuid": "h53ea67a9gbb7dg51f2gb1d1g6b6662167417",
  "version": 1,
  "text": "<i>Leave.</i>"
 },
 {
  "contentuid": "h6487c094g708bg59b1gb13ag89a9375d0514",
  "version": 1,
  "text": "I'm sure. The answer is no."
 },
 {
  "contentuid": "h33cfa1bcg25ecg5a40gb0b0g0bf225388b26",
  "version": 1,
  "text": "On second thought - join us."
 },
 {
  "contentuid": "hb2ad9ac1ge84bg5791gb00dg2063807e49fa",
  "version": 1,
  "text": "<i>Leave.</i>"
 },
 {
  "contentuid": "h438080bdgd232g5db7ga939gd65ac529e8b3",
  "version": 1,
  "text": "There. All is forgiven - this once."
 },
 {
  "contentuid": "h9e018daegb53ag5b50gbafdg0fa0223436c8",
  "version": 1,
  "text": "[Refuse] So be it. I'm keeping them."
 },
 {
  "contentuid": "h79058dafg9e34g5bccga2e5gc9aa765228bd",
  "version": 1,
  "text": "Wait - take them back."
 },
 {
  "contentuid": "hd2ba42cfg7db1g5c4eg9d36g6b7a5c766bee",
  "version": 1,
  "text": "Let's talk."
 },
 {
  "contentuid": "h985e3266g91e4g55a7gba9dg9e4b5a6e71ec",
  "version": 1,
  "text": "You've been watching me all evening."
 },
 {
  "contentuid": "hbeb61f84ga02bg5b2cgbd6cg5846fee1a9b2",
  "version": 1,
  "text": "Join me."
 },
 {
  "contentuid": "hcd91b9a4gffe4g5537g9a77g792517e01b14",
  "version": 1,
  "text": "Join me."
 },
 {
  "contentuid": "h9f4dbf3cgef21g5146ga302gad001473789d",
  "version": 1,
  "text": "Wait for me at camp."
 },
 {
  "contentuid": "h00419e0ag3287g55d8g8ec9g36b8957a8553",
  "version": 1,
  "text": "I want you gone. For good."
 },
 {
  "contentuid": "h02316e49g8c1dg5d58gb82cg8cba49fc4d54",
  "version": 1,
  "text": "<i>Leave.</i>"
 },
 {
  "contentuid": "h4637e676g7b83g5d81gb943g8f94e43c121b",
  "version": 1,
  "text": "Why are you really here, devil?"
 },
 {
  "contentuid": "hf2d9bdf3g8b20g5b6cg956cgf1b6bcf77e80",
  "version": 1,
  "text": "You want something from me. More than you've said."
 },
 {
  "contentuid": "h8b48f8b5g1dcbg51d3ga60dge4c162c67ba3",
  "version": 1,
  "text": "Keep your claws where I can see them and we'll get along."
 },
 {
  "contentuid": "hb9f5b732g22bag575ag8873g5309012137bb",
  "version": 1,
  "text": "Talk straight or don't talk, hellspawn."
 },
 {
  "contentuid": "hbcdc9233gfa85g58e4g86d2g245b0e1c89bf",
  "version": 1,
  "text": "Admit it. I've handled all this rather deftly."
 },
 {
  "contentuid": "hcdc5f23dg052fg5b08gb0b4gb6db2c8d74a6",
  "version": 1,
  "text": "You never warn me about what's ahead."
 },
 {
  "contentuid": "h5b1b0adag7597g511cg828bg1b705ff310d3",
  "version": 1,
  "text": "What do I owe you for your help?"
 },
 {
  "contentuid": "hd84d73bbg885dg55fdgafa3g8fa951f502f4",
  "version": 1,
  "text": "I don't like where this is going. But I'll see it through."
 },
 {
  "contentuid": "h8ad715c7gda66g57b3ga3c8geb500ba86ad6",
  "version": 1,
  "text": "Why do you keep me so close, really?"
 },
 {
  "contentuid": "h80cf359fgd626g5a92g9824g54b812f5204f",
  "version": 1,
  "text": "Something else."
 },
 {
  "contentuid": "hc3d2e422gdf4ag58c4gb459g9951bd5aa19b",
  "version": 1,
  "text": "I'll leave you to it."
 },
 {
  "contentuid": "h39351bcag6aa1g5183gbeaag9a731c7888c7",
  "version": 1,
  "text": "In what ways are you charmed, exactly?"
 },
 {
  "contentuid": "hce46b7cbg38b5g5838ga685g58fc11a27724",
  "version": 1,
  "text": "Not tonight, devil."
 },
 {
  "contentuid": "h4112306ag9290g5369ga403g78fa1e394bfb",
  "version": 1,
  "text": "Yes. Leave, and don't come back."
 },
 {
  "contentuid": "h9aea2ae3g8612g5bbega67bg99bd45a206fc",
  "version": 1,
  "text": "No. Stay."
 },
 {
  "contentuid": "h67343539g3682g55fbg90b0g6d4bb9bf84e2",
  "version": 1,
  "text": "Then name it."
 },
 {
  "contentuid": "hcadb1491g16c8g57deg95efg8ba95781f091",
  "version": 1,
  "text": "Careful, devil. I might take you up on that."
 },
 {
  "contentuid": "h7d53c9eag71a5g51dag935dge86372cfa1a6",
  "version": 1,
  "text": "You'd find me harder to charm than most."
 },
 {
  "contentuid": "h729afc57g06e7g517dgbfdbg7b989872a8f9",
  "version": 1,
  "text": "And if I told you I was the one doing the charming?"
 },
 {
  "contentuid": "hec18f04bga502g5e41gbf6dg2b6519f7abf1",
  "version": 1,
  "text": "Our association is ended. Don't expect me to come when you call."
 },
 {
  "contentuid": "h3b92b17egac45g56c6g9014gb3e454d1a269",
  "version": 1,
  "text": "Here? With the whole camp listening?"
 },
 {
  "contentuid": "h140e29d0ge504g5290g8d2fg455270979a48",
  "version": 1,
  "text": "Lead the way."
 },
 {
  "contentuid": "hcb4f0fd7g5d61g5763g97d1gd40087366537",
  "version": 1,
  "text": "It's been a pleasure, Raphael."
 },
 {
  "contentuid": "haaefc5dag069dg5de0g8e7egffe54d1c213c",
  "version": 1,
  "text": "Goodbye, devil."
 }
]
